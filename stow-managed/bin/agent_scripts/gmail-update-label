#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///

import argparse, json, subprocess, sys

GWS = ["uvx", "gws-cli@1.3.1", "gmail", "update-label"]


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def unwrap(obj):
    if isinstance(obj, str):
        try:
            return unwrap(json.loads(obj))
        except json.JSONDecodeError:
            return None
    if isinstance(obj, list):
        for item in obj:
            if isinstance(item, dict) and "id" in item:
                return item
        return None
    if isinstance(obj, dict):
        if "label_id" in obj:
            return {"id": obj["label_id"], "name": obj.get("name", "")}
        if "id" in obj:
            return obj
        for key in ("label", "data"):
            if key in obj:
                found = unwrap(obj[key])
                if found is not None:
                    return found
    return None


def main():
    parser = argparse.ArgumentParser(description="Update a Gmail label (gws-cli wrapper)")
    parser.add_argument("label_id", help="Label ID (e.g. Label_12345) — see gmail-labels")
    parser.add_argument("--name", help="New label name (rename)")
    parser.add_argument("--message-visibility", choices=["show", "hide"],
                        help="Show/hide in message list")
    parser.add_argument("--label-visibility",
                        choices=["labelShow", "labelShowIfUnread", "labelHide"],
                        help="Visibility in the label list")
    parser.add_argument("--text-color", help="Text color, e.g. #ffffff")
    parser.add_argument("--background-color", help="Background color, e.g. #039be5")
    parser.add_argument("--json", action="store_true", dest="json_out",
                        help="Output raw gws-cli response as JSON")
    args = parser.parse_args()

    cmd = GWS + [args.label_id]
    for flag in ("--name", "--message-visibility", "--label-visibility",
                 "--text-color", "--background-color"):
        val = getattr(args, flag.lstrip("-").replace("-", "_"))
        if val:
            cmd += [flag, val]

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        msg = result.stderr.strip()
        if result.stdout:
            try:
                err = json.loads(result.stdout)
                msg = err.get("message", msg) or msg
            except json.JSONDecodeError:
                pass
        eprint(msg)
        sys.exit(result.returncode)

    if args.json_out:
        print(result.stdout, end="")
        return

    try:
        outer = json.loads(result.stdout)
    except json.JSONDecodeError:
        eprint("Unexpected non-JSON output:")
        print(result.stdout, end="")
        sys.exit(1)

    label = unwrap(outer)
    if label is None:
        eprint("Unrecognized update-label response shape; raw output follows.")
        print(result.stdout, end="")
        sys.exit(1)

    print(f"Updated label: {label.get('id', '')} | {label.get('name', '')}")


if __name__ == "__main__":
    main()
