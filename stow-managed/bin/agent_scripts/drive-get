#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///

import json, subprocess, sys

GWS = ["uvx", "gws-cli@1.3.1", "drive", "get"]


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def main():
    args = sys.argv[1:]
    if len(args) != 1:
        eprint("Usage: drive-get <file-id>")
        sys.exit(2)

    file_id = args[0]

    result = subprocess.run(GWS + [file_id], capture_output=True, text=True)
    if result.returncode != 0:
        msg = result.stderr.strip()
        if result.stdout:
            try:
                err = json.loads(result.stdout)
                msg = err.get("message", msg) or msg
            except json.JSONDecodeError:
                pass
        eprint(msg)
        sys.exit(result.returncode)

    try:
        outer = json.loads(result.stdout)
    except json.JSONDecodeError:
        eprint("Unexpected non-JSON output:")
        print(result.stdout, end="")
        sys.exit(1)

    def extract(wrapped):
        if isinstance(wrapped, dict) and "data" in wrapped:
            return wrapped["data"]
        return wrapped

    file_str = extract(outer.get("file"))
    if not file_str:
        eprint("No file metadata returned.")
        sys.exit(1)

    meta = json.loads(file_str) if isinstance(file_str, str) else file_str

    fields = [
        ("id", "ID"),
        ("name", "Name"),
        ("mime_type", "MIME Type"),
        ("size", "Size"),
        ("created_time", "Created"),
        ("modified_time", "Modified"),
        ("description", "Description"),
        ("starred", "Starred"),
        ("trashed", "Trashed"),
        ("parents", "Parents"),
        ("web_view_link", "Link"),
        ("web_content_link", "Download Link"),
    ]
    for key, label in fields:
        val = meta.get(key)
        if val:
            print(f"{label}: {val}")

    owners = meta.get("owners") or []
    if owners:
        print(f"Owners: {', '.join(o.get('email','') for o in owners)}")


if __name__ == "__main__":
    main()
