"""Create a new Google Sheet, optionally naming its tabs."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _gws_workspace import extract, run_gws


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("title")
    p.add_argument("--sheets", help='comma-separated tab names, e.g. "Data,Notes"')
    p.add_argument("--folder", help="Drive folder ID to create the sheet in")
    args = p.parse_args()

    sub = ["sheets", "create"]
    if args.sheets:
        sub += ["--sheets", args.sheets]
    if args.folder:
        sub += ["--folder", args.folder]

    outer = run_gws(sub + ["--", args.title])
    title = extract(outer.get("title", args.title))
    print(f"Created: {title} (id: {outer.get('spreadsheet_id', '')}) {outer.get('web_view_link', '')}")


if __name__ == "__main__":
    main()
