"""List a spreadsheet's title and tabs: sheet_id | title | rows x cols."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _gws_workspace import sheet_tabs


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("spreadsheet_id")
    args = p.parse_args()

    title, tabs = sheet_tabs(args.spreadsheet_id)
    print(f"Spreadsheet: {title}")
    for t in tabs:
        print(f"{t.get('sheet_id')} | {t.get('title')} | {t.get('row_count')} x {t.get('column_count')}")


if __name__ == "__main__":
    main()
