#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Move a Drive file to the trash. Reversible with drive-restore; never permanent.

Prints the file's name, MIME type and parents first. Refuses a file that is already
trashed, and refuses a folder (trashing it hides everything inside) unless --folder
is given. There is no wrapper for permanent delete or emptying the trash.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _gws_workspace import die, json_field, run_gws

FOLDER_MIME = "application/vnd.google-apps.folder"


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    p.add_argument("file_id")
    p.add_argument("--folder", action="store_true", help="allow trashing a folder")
    args = p.parse_args()

    meta = json_field(run_gws(["drive", "get", args.file_id]), "file")
    if not meta:
        die("No file metadata returned.")
    name = meta.get("name", "?")
    mime = meta.get("mime_type", "?")
    print(f"Trashing: {name} | {mime} | parents: {', '.join(meta.get('parents') or []) or '-'}")
    if meta.get("trashed"):
        die(f"{name!r} is already in the trash.")
    if mime == FOLDER_MIME and not args.folder:
        die(f"{name!r} is a folder; trashing it hides everything inside. Re-run with --folder to confirm.", 2)

    run_gws(["drive", "delete", args.file_id])
    print(f"Trashed: {name} — undo with drive-restore {args.file_id}")


if __name__ == "__main__":
    main()
