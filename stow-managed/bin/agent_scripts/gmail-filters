#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///

import argparse, json, subprocess, sys

GWS = ["uvx", "gws-cli@1.3.1", "gmail", "filters"]


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def unwrap(obj):
    if isinstance(obj, str):
        try:
            return unwrap(json.loads(obj))
        except json.JSONDecodeError:
            return None
    if isinstance(obj, list):
        return obj
    if isinstance(obj, dict):
        for key in ("filters", "data"):
            if key in obj:
                found = unwrap(obj[key])
                if found is not None:
                    return found
    return None


def criteria_summary(criteria):
    parts = []
    for key in ("from", "to", "subject", "query"):
        if criteria.get(key):
            parts.append(f"{key}={criteria[key]}")
    if criteria.get("hasAttachment") or criteria.get("has_attachment"):
        parts.append("has-attachment")
    return " ".join(parts) if parts else "-"


def action_summary(action):
    parts = []
    if action.get("addLabelIds") or action.get("add_label_ids"):
        labels = action.get("addLabelIds") or action.get("add_label_ids")
        parts.append("add=" + ",".join(labels))
    if action.get("removeLabelIds") or action.get("remove_label_ids"):
        labels = action.get("removeLabelIds") or action.get("remove_label_ids")
        parts.append("remove=" + ",".join(labels))
    if action.get("forward") or action.get("forwardTo"):
        parts.append("forward=" + (action.get("forward") or action.get("forwardTo")))
    return " ".join(parts) if parts else "-"


def main():
    parser = argparse.ArgumentParser(description="List Gmail filters (gws-cli wrapper)")
    parser.add_argument("--json", action="store_true", dest="json_out",
                        help="Output raw filters array as JSON")
    args = parser.parse_args()

    result = subprocess.run(GWS, capture_output=True, text=True)
    if result.returncode != 0:
        msg = result.stderr.strip()
        if result.stdout:
            try:
                err = json.loads(result.stdout)
                msg = err.get("message", msg) or msg
            except json.JSONDecodeError:
                pass
        eprint(msg)
        sys.exit(result.returncode)

    try:
        outer = json.loads(result.stdout)
    except json.JSONDecodeError:
        eprint("Unexpected non-JSON output:")
        print(result.stdout, end="")
        sys.exit(1)

    filters = unwrap(outer)
    if filters is None:
        eprint("Unrecognized filters response shape; raw output follows.")
        print(result.stdout, end="")
        sys.exit(1)

    if args.json_out:
        print(json.dumps(filters, indent=2))
        return

    if not filters:
        print("No filters found.")
        return

    print("id | criteria | action")
    print("---")
    for f in filters:
        print(f"{f.get('id', '')} | {criteria_summary(f.get('criteria', {}))} | "
              f"{action_summary(f.get('action', {}))}")


if __name__ == "__main__":
    main()
