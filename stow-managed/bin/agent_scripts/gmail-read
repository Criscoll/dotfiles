#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["gws-cli==1.3.1"]
# ///

import base64, html, re, sys

from googleapiclient.errors import HttpError
from gws.services.gmail import GmailService


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def html_to_text(markup: str) -> str:
    markup = re.sub(r"(?is)<(head|style|script)\b.*?</\1>", "", markup)
    markup = re.sub(r"(?i)<br\s*/?>|</(p|div|tr|li|h[1-6]|table)>", "\n", markup)
    markup = re.sub(r"(?i)</t[dh]>", " ", markup)
    return html.unescape(re.sub(r"<[^>]+>", "", markup)).replace("\xa0", " ")


def clean_text(text: str) -> str:
    text = re.sub(r"[ \t]+\n", "\n", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def decode_part(part: dict) -> str:
    data = part.get("body", {}).get("data", "")
    return base64.urlsafe_b64decode(data + "=" * (-len(data) % 4)).decode("utf-8", errors="replace")


def find_part(payload: dict, mime: str):
    """Depth-first search for the first non-attachment part of the given MIME type."""
    if payload.get("mimeType") == mime and payload.get("body", {}).get("data") and not payload.get("filename"):
        return payload
    for sub in payload.get("parts", []):
        found = find_part(sub, mime)
        if found:
            return found
    return None


def extract_body(payload: dict) -> str:
    # gws-cli's own extractor only looks at text/plain, so HTML-only mail comes back empty.
    plain = find_part(payload, "text/plain")
    if plain:
        return clean_text(decode_part(plain))
    markup = find_part(payload, "text/html")
    if markup:
        return clean_text(html_to_text(decode_part(markup)))
    return ""


def main():
    args = sys.argv[1:]
    full = False
    limit = 2000
    message_id = None

    i = 0
    while i < len(args):
        if args[i] == "--full":
            full = True
            i += 1
        elif args[i] == "--limit" and i + 1 < len(args):
            limit = int(args[i + 1])
            i += 2
        else:
            message_id = args[i]
            i += 1

    if not message_id:
        eprint("Usage: gmail-read [--full] [--limit N] <message-id>")
        sys.exit(2)

    service = GmailService()
    try:
        msg = service.execute(service.service.users().messages().get(userId="me", id=message_id, format="full"))
    except HttpError as e:
        eprint(f"Gmail API error: {e.reason}")
        sys.exit(1)

    payload = msg.get("payload", {})
    headers = {h["name"].lower(): h["value"] for h in payload.get("headers", [])}
    subject = headers.get("subject", "(no subject)")
    from_addr = headers.get("from", "")
    to_addr = headers.get("to", "")
    cc = headers.get("cc", "")
    date = headers.get("date", "")
    labels = msg.get("labelIds", [])
    body_clean = extract_body(payload)
    if not full and len(body_clean) > limit:
        body_clean = body_clean[:limit].rstrip() + "\n[…truncated, use --full to show all]"

    attachments = service._extract_attachments(payload)

    print(f"From:    {from_addr}")
    print(f"To:      {to_addr}")
    if cc:
        print(f"Cc:      {cc}")
    print(f"Date:    {date}")
    print(f"Labels:  {', '.join(labels)}")
    print(f"Subject: {subject}")
    print("-" * 40)
    print(body_clean if body_clean else "[No body text]")

    if attachments:
        print(f"\nAttachments ({len(attachments)}):")
        for i, att in enumerate(attachments, 1):
            filename = att.get("filename", "(unknown)")
            mime = att.get("mime_type", "")
            size_bytes = att.get("size", 0)
            att_id = att.get("attachment_id", "")
            size_kb = round(size_bytes / 1024, 1)
            print(f"  [{i}] {filename}  {mime}  {size_kb} KB  (attachment_id: {att_id})")


if __name__ == "__main__":
    main()