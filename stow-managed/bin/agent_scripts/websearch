#!/bin/sh
# websearch — tiered web search for agents.
#
# Primary:  Brave Search API. Default endpoint is LLM Context
#           (https://api.search.brave.com/res/v1/llm/context) — search +
#           pre-extracted page content in one call. `--search-only` switches to
#           raw web search (titles + snippets, cheapest per request).
# Fallback: SearXNG via websearch-searxng (Docker-backed), used automatically
#           when no API key is available or the Brave call fails (auth, quota,
#           rate limit, network).
#
# Usage: websearch [-n N] [-t TIME] [--search-only] [--provider brave|searxng] QUERY
#
# Options:
#   -n N         max results (default: 10; Brave caps at 50)
#   -t TIME      freshness: day|week|month|year (pd|pw|pm|py also accepted)
#   --search-only  raw web search — titles + snippets only, then use the
#                  web-crawl skill for content (cheapest Brave tier)
#   --provider   force 'brave' (no fallback, error on failure) or 'searxng'
#
# Output: JSON array [{title, url, snippet, engine}] on stdout.
#         With the default (LLM Context) endpoint, `snippet` carries extracted
#         page content — substantial enough that webcrawl is rarely needed.
#         Diagnostics (provider used, fallbacks, errors) go to stderr.
#
# API key: read from $BRAVE_API_KEY if set, else sourced from
#          ~/.config/agent-scripts/env (untracked per-machine file, chmod 600).
#          Cost: ~$5/1k requests; $5 in free credits applied monthly.

set -e

# Resolve the sibling fallback script relative to this file's location (not
# $HOME) so delegation works regardless of the caller's environment.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SEARXNG_SCRIPT="$SELF_DIR/websearch-searxng"

MAX_RESULTS=10
FRESHNESS_IN=""
PROVIDER="auto"   # auto | brave | searxng
SEARCH_ONLY=0

# ── Argument parsing ────────────────────────────────────────────────────────
QUERY=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) MAX_RESULTS="$2"; shift 2 ;;
    -t) FRESHNESS_IN="$2"; shift 2 ;;
    --search-only) SEARCH_ONLY=1; shift ;;
    --provider)
      case "${2:-}" in
        brave|searxng) PROVIDER="$2" ;;
        *) echo "Error: --provider takes 'brave' or 'searxng'" >&2; exit 1 ;;
      esac
      shift 2 ;;
    -h|--help)
      sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      if [ -z "$QUERY" ]; then QUERY="$1"; else QUERY="$QUERY $1"; fi
      shift
      ;;
  esac
done

if [ -z "$QUERY" ]; then
  echo "Error: query required." >&2
  echo "Usage: websearch [-n N] [-t day|month|year] [--search-only] [--provider brave|searxng] QUERY" >&2
  exit 1
fi

# Cap results at Brave's maximum.
if [ "$MAX_RESULTS" -gt 50 ]; then
  MAX_RESULTS=50
fi

# ── SearXNG fallback delegation ──────────────────────────────────────────────
# Shared by: --provider searxng, auto mode without a key, and auto mode after a
# failed Brave call. websearch-searxng accepts -n, -t (day|month|year only), QUERY.
fallback() {
  REASON="$1"
  if [ "$PROVIDER" = "brave" ]; then
    echo "Error: Brave search failed ($REASON) and --provider brave forbids fallback" >&2
    exit 1
  fi
  echo "Falling back to SearXNG ($REASON)..." >&2
  SEARXNG_ARGS="-n $MAX_RESULTS"
  case "$FRESHNESS_IN" in
    day|month|year)   SEARXNG_ARGS="$SEARXNG_ARGS -t $FRESHNESS_IN" ;;
    pd)               SEARXNG_ARGS="$SEARXNG_ARGS -t day" ;;
    pm)               SEARXNG_ARGS="$SEARXNG_ARGS -t month" ;;
    py)               SEARXNG_ARGS="$SEARXNG_ARGS -t year" ;;
    pw|week)          echo "Note: SearXNG has no week filter; ignoring -t" >&2 ;;
  esac
  # Deliberate word-splitting: SEARXNG_ARGS holds simple flag tokens only.
  # shellcheck disable=SC2086
  exec "$SEARXNG_SCRIPT" $SEARXNG_ARGS "$QUERY"
}

# ── Key loading ──────────────────────────────────────────────────────────────
# Prefer the ambient env var; otherwise source the per-machine untracked env
# file. Sourcing (not grepping) means shell quoting rules apply — values there
# may be quoted safely.
if [ -z "$BRAVE_API_KEY" ] && [ -f "$HOME/.config/agent-scripts/env" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.config/agent-scripts/env"
fi

if [ "$PROVIDER" = "searxng" ]; then
  fallback "provider forced to searxng"
fi

if [ -z "$BRAVE_API_KEY" ]; then
  fallback "no BRAVE_API_KEY (env or ~/.config/agent-scripts/env)"
fi

# ── Freshness mapping (SearXNG words → Brave freshness codes) ────────────────
FRESHNESS=""
case "$FRESHNESS_IN" in
  day)   FRESHNESS="pd" ;;
  week)  FRESHNESS="pw" ;;
  month) FRESHNESS="pm" ;;
  year)  FRESHNESS="py" ;;
  pd|pw|pm|py) FRESHNESS="$FRESHNESS_IN" ;;
esac

# ── Brave request ────────────────────────────────────────────────────────────
if [ "$SEARCH_ONLY" = "1" ]; then
  BRAVE_URL="https://api.search.brave.com/res/v1/web/search"
  echo "Searching (Brave, raw): $QUERY" >&2
else
  # LLM Context default: token budget left at the 8192 default — per-request
  # pricing means more tokens cost nothing and more content helps the agent.
  BRAVE_URL="https://api.search.brave.com/res/v1/llm/context"
  echo "Searching (Brave LLM Context): $QUERY" >&2
fi

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
HTTP_CODE=$(curl -s --compressed -o "$TMP" -w "%{http_code}" \
  -H "X-Subscription-Token: $BRAVE_API_KEY" \
  -H "Accept: application/json" \
  -G "$BRAVE_URL" \
  --data-urlencode "q=$QUERY" \
  --data-urlencode "count=$MAX_RESULTS" \
  ${FRESHNESS:+--data-urlencode "freshness=$FRESHNESS"}) || {
  fallback "curl/network failure"
}

if [ "$HTTP_CODE" != "200" ]; then
  ERR_DETAIL=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('error', {}).get('code', ''), '-', d.get('error', {}).get('detail', '')[:120])
except Exception:
    print('non-JSON response')" "$TMP" 2>/dev/null || echo "unparseable response")
  fallback "HTTP $HTTP_CODE ($ERR_DETAIL)"
fi

# ── Normalize to the shared output shape ─────────────────────────────────────
python3 -c "
import json, sys
n = int(sys.argv[2])
d = json.load(open(sys.argv[1]))
if 'grounding' in d:
    # LLM Context: extracted content chunks per source
    items = [
        {
            'title': it.get('title', ''),
            'url': it.get('url', ''),
            'snippet': ' '.join(it.get('snippets', [])),
            'engine': 'brave-llm-context',
        }
        for it in d.get('grounding', {}).get('generic', [])
    ]
else:
    # Raw web search: descriptions only
    items = [
        {
            'title': r.get('title', ''),
            'url': r.get('url', ''),
            'snippet': r.get('description', ''),
            'engine': 'brave',
        }
        for r in d.get('web', {}).get('results', [])
    ]
print(json.dumps(items[:n], ensure_ascii=False, indent=2))
" "$TMP" "$MAX_RESULTS"
