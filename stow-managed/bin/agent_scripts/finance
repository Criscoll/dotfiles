"""Deterministic financial calculations: mortgage, payoff, compounding, depreciation, TVM."""

import argparse
import json
import sys
from decimal import ROUND_HALF_UP, Decimal

# Compounding / pay periods per year, keyed by frequency name.
PERIODS_PER_YEAR = {"monthly": 12, "fortnightly": 26, "weekly": 52}
# Safety ceiling on the month-by-month payoff loop: 200 years of weekly payments.
# A payment above the interest-only threshold always amortizes, so this is never
# reached in practice — it just prevents a runaway loop on pathological input.
MAX_PERIODS = 200 * 52


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def _die(msg):
    eprint(f"Error: {msg}")
    sys.exit(2)


def _money(x, dp=2):
    """Round a monetary amount to `dp` decimal places, half-up (not banker's).

    Compute the TVM core in float (≈15 significant digits — far more than cents
    need), then quantize the *display* value here to kill float artifacts like
    1798.6500000001 and to round half-up the way money conventionally does.
    """
    quantum = Decimal(1).scaleb(-dp)  # 10**-dp, e.g. Decimal("0.01") for dp=2
    return float(Decimal(str(x)).quantize(quantum, rounding=ROUND_HALF_UP))


def _pct(x):
    """Round a rate/percentage to 6 dp — enough resolution for basis points."""
    return round(x, 6)


# --- Core time-value-of-money helpers (shared across subcommands) -------------


def _fv(pv, pmt, i, n, timing):
    """Future value of a starting balance `pv` plus a level annuity of `pmt`.

    `i` = per-period rate, `n` = number of periods. `timing` is "end" (ordinary
    annuity, payment at period end) or "begin" (annuity-due, payment at start —
    each contribution earns one extra period of growth).
    """
    if i == 0:
        return pv + pmt * n
    growth = (1 + i) ** n
    annuity = pmt * (growth - 1) / i  # FV of an ordinary annuity of 1
    if timing == "begin":
        annuity *= 1 + i  # annuity-due: one extra compounding period
    return pv * growth + annuity


def _pv(fv, pmt, i, n, timing):
    """Present value: the balance today that grows to `fv` given `pmt` deposits.

    Inverse of `_fv`: fv = pv*(1+i)^n + annuity(pmt)  →  pv = (fv - annuity)/growth.
    """
    if i == 0:
        return fv - pmt * n
    growth = (1 + i) ** n
    annuity = pmt * (growth - 1) / i
    if timing == "begin":
        annuity *= 1 + i
    return (fv - annuity) / growth


def _pmt(pv, i, n):
    """Level payment that fully amortizes `pv` over `n` periods at rate `i`.

    PMT = P·i / (1 − (1+i)^−N). With i=0 it's just the principal split evenly.
    """
    if i == 0:
        return pv / n
    return pv * i / (1 - (1 + i) ** -n)


def _run_payoff(loan, rate_at, payment, extra, lumps,
                offset_start, offset_contribution, offset_mode, collect_schedule):
    """Period-by-period payoff simulation with an offset account and a rate path.

    `rate_at(period)` returns the per-period rate fraction for that period, so a
    single run can carry a variable rate. An offset account sits against the loan:
    interest each period accrues only on the net position `max(loan − offset, 0)`.

    Two "paid off" definitions, by `offset_mode`:
      - "loan": offset only lowers interest; the loan still amortizes to zero
        (standard offset mortgage). Terminates on the partial-final-payment clamp.
      - "net": payoff is reached when the offset catches the loan (`loan <= offset`)
        — the point you could withdraw the offset and clear the balance outright.

    Returns (periods, final_payment, total_paid, total_interest, schedule). When
    `collect_schedule`, `schedule` is a list of raw per-period rows (the caller
    formats them); otherwise it is None.

    A variable rate can stall a loan mid-way, so hitting MAX_PERIODS with the loan
    still outstanding is a hard error rather than a bogus period count.
    """
    periodic = payment + extra
    bal = loan
    offset = offset_start
    total_paid = 0.0
    total_interest = 0.0
    final_payment = 0.0
    schedule = [] if collect_schedule else None

    if offset_mode == "net" and offset >= bal:
        return 0, 0.0, 0.0, 0.0, schedule  # offset already covers the loan

    period = 0
    done = False
    while period < MAX_PERIODS:
        period += 1
        rate = rate_at(period)
        opening = bal
        net = max(bal - offset, 0.0)  # interest accrues only on the net position
        interest = net * rate
        bal += interest
        total_interest += interest
        offset += offset_contribution
        pay_this = periodic + lumps.get(period, 0.0)

        if offset_mode == "loan" and pay_this >= bal:
            pay_this = bal  # partial final payment clears the loan exactly
            final_payment = pay_this
            bal = 0.0
            total_paid += pay_this
            done = True
        else:
            bal -= pay_this
            total_paid += pay_this
            if offset_mode == "net" and bal <= offset:
                final_payment = pay_this  # offset catches the loan this period
                done = True

        if collect_schedule:
            schedule.append({
                "period": period,
                "rate": rate,
                "opening_balance": opening,
                "interest": interest,
                "payment": pay_this,
                "principal": pay_this - interest,
                "offset": offset,
                "closing_balance": bal,
            })

        if done:
            break

    if not done:
        _die("payment does not amortize the loan under this rate path")

    return period, final_payment, total_paid, total_interest, schedule


def _years_months(periods, periods_per_year):
    """Express a period count as whole years + months, for any pay frequency."""
    total_months = periods / periods_per_year * 12
    years = int(total_months // 12)
    months = round(total_months - years * 12)
    if months == 12:  # rounding can push to a full year
        years += 1
        months = 0
    return years, months


# --- Subcommand handlers ------------------------------------------------------


def cmd_mortgage(args):
    if args.principal <= 0:
        _die("--principal must be positive")
    if args.years <= 0:
        _die("--years must be positive")
    if args.rate < 0:
        _die("--rate must be non-negative")
    ppy = PERIODS_PER_YEAR[args.pay_freq]
    n = round(args.years * ppy)
    i = (args.rate / 100) / ppy  # annual percent → per-period fraction
    payment = _pmt(args.principal, i, n)
    total_paid = payment * n
    total_interest = total_paid - args.principal
    return {
        "command": "mortgage",
        "result": _money(payment, args.dp),
        "payment_per_period": _money(payment, args.dp),
        "pay_freq": args.pay_freq,
        "periods_per_year": ppy,
        "num_payments": n,
        "principal": _money(args.principal, args.dp),
        "annual_rate_pct": _pct(args.rate),
        "total_paid": _money(total_paid, args.dp),
        "total_interest": _money(total_interest, args.dp),
    }


def _parse_lumps(values):
    """Parse repeated --lump AMT@PERIOD flags into {period: total_amount}."""
    lumps: dict[int, float] = {}
    for raw in values or []:
        parts = raw.split("@")
        if len(parts) != 2:
            _die(f"--lump must be AMT@PERIOD (e.g. 5000@12), got {raw!r}")
        try:
            amount = float(parts[0])
            period = int(parts[1])
        except ValueError:
            _die(f"--lump AMT@PERIOD must be number@integer, got {raw!r}")
        if amount <= 0 or period <= 0:
            _die(f"--lump amount and period must be positive, got {raw!r}")
        lumps[period] = lumps.get(period, 0.0) + amount
    return lumps


def _parse_rate_steps(values, ppy):
    """Parse repeated --rate-step PCT@PERIOD flags into a sorted rate path.

    Each step means "from PERIOD onward, use PCT" (annual %). Returns a list of
    (period, per_period_fraction) sorted by period, for building `rate_at`.
    """
    steps: list[tuple[int, float]] = []
    for raw in values or []:
        parts = raw.split("@")
        if len(parts) != 2:
            _die(f"--rate-step must be PCT@PERIOD (e.g. 8@60), got {raw!r}")
        try:
            pct = float(parts[0])
            period = int(parts[1])
        except ValueError:
            _die(f"--rate-step PCT@PERIOD must be number@integer, got {raw!r}")
        if pct < 0 or period < 1:
            _die(f"--rate-step PCT must be >= 0 and PERIOD >= 1, got {raw!r}")
        steps.append((period, (pct / 100) / ppy))
    steps.sort(key=lambda s: s[0])
    return steps


def _parse_rate_band(raw):
    """Parse --rate-band LOW,HIGH into two annual-percent floats (LOW <= HIGH)."""
    parts = raw.split(",")
    if len(parts) != 2:
        _die(f"--rate-band must be LOW,HIGH (e.g. 5,8), got {raw!r}")
    try:
        low = float(parts[0])
        high = float(parts[1])
    except ValueError:
        _die(f"--rate-band LOW,HIGH must be two numbers, got {raw!r}")
    if low < 0 or high < 0:
        _die(f"--rate-band values must be non-negative, got {raw!r}")
    if low > high:
        _die(f"--rate-band LOW must not exceed HIGH, got {raw!r}")
    return low, high


def _band_run(args, annual_pct, ppy, payment, lumps):
    """Flat-rate payoff run for one edge of a --rate-band sensitivity bracket."""
    i = (annual_pct / 100) / ppy
    periods, final_payment, _, total_interest, _ = _run_payoff(
        args.balance, lambda period: i, payment, args.extra, lumps,
        args.offset, args.offset_contribution, args.offset_mode, False,
    )
    years, months = _years_months(periods, ppy)
    return {
        "annual_rate_pct": _pct(annual_pct),
        "periods_to_payoff": periods,
        "years_months": f"{years}y {months}m",
        "final_payment": _money(final_payment, args.dp),
        "total_interest": _money(total_interest, args.dp),
    }


def cmd_payoff(args):
    if args.balance <= 0:
        _die("--balance must be positive")
    if args.rate < 0:
        _die("--rate must be non-negative")
    if args.offset < 0:
        _die("--offset must be non-negative")
    if args.offset_contribution < 0:
        _die("--offset-contribution must be non-negative")
    ppy = PERIODS_PER_YEAR[args.pay_freq]
    base_i = (args.rate / 100) / ppy

    derived_payment = None
    if args.income is not None:
        if args.payment is not None:
            _die("give either --payment or --income/--expenses, not both")
        if args.expenses is None:
            _die("income mode requires --expenses alongside --income")
        payment = args.income - args.expenses
        derived_payment = payment
    elif args.payment is not None:
        payment = args.payment
    else:
        _die("provide --payment, or --income with --expenses")

    if payment <= 0:
        _die("payment (or income − expenses) must be positive")

    lumps = _parse_lumps(args.lump)
    steps = _parse_rate_steps(args.rate_step, ppy)

    def rate_at(period):
        """Per-period rate for `period`: the most recent applicable step, else base."""
        rate = base_i
        for step_period, step_i in steps:
            if period >= step_period:
                rate = step_i
            else:
                break  # steps are sorted ascending
        return rate

    periodic = payment + args.extra

    # Interest-only guard on the *net* opening position at the *opening* rate: if
    # the periodic payment can't cover the interest that accrues on what the offset
    # doesn't cover, the balance grows without bound and never amortizes. If the net
    # position starts at/below zero (offset covers the loan) it trivially amortizes.
    i_opening = rate_at(1)
    net_opening = max(args.balance - args.offset, 0.0)
    interest_only = i_opening * net_opening
    if i_opening > 0 and net_opening > 0 and periodic <= interest_only:
        _die(
            f"payment of {_money(periodic, args.dp)} per {args.pay_freq} period does not cover "
            f"the interest-only amount of {_money(interest_only, args.dp)}; the balance never amortizes"
        )

    periods, final_payment, total_paid, total_interest, schedule = _run_payoff(
        args.balance, rate_at, payment, args.extra, lumps,
        args.offset, args.offset_contribution, args.offset_mode, args.schedule,
    )
    years, months = _years_months(periods, ppy)

    out = {
        "command": "payoff",
        "result": periods,
        "periods_to_payoff": periods,
        "years_months": f"{years}y {months}m",
        "pay_freq": args.pay_freq,
        "periods_per_year": ppy,
        "balance": _money(args.balance, args.dp),
        "annual_rate_pct": _pct(args.rate),
        "payment_per_period": _money(payment, args.dp),
        "extra_per_period": _money(args.extra, args.dp),
        "final_payment": _money(final_payment, args.dp),
        "total_paid": _money(total_paid, args.dp),
        "total_interest": _money(total_interest, args.dp),
    }
    if derived_payment is not None:
        out["derived_payment"] = _money(derived_payment, args.dp)
        out["income"] = _money(args.income, args.dp)
        out["expenses"] = _money(args.expenses, args.dp)
    # Echo offset inputs only when the offset feature is actually engaged.
    if args.offset > 0 or args.offset_contribution > 0 or args.offset_mode != "loan":
        out["offset_start"] = _money(args.offset, args.dp)
        out["offset_contribution_per_period"] = _money(args.offset_contribution, args.dp)
        out["offset_mode"] = args.offset_mode
    if steps:
        out["rate_steps"] = [
            {"period": p, "annual_rate_pct": _pct(step_i * ppy * 100)} for p, step_i in steps
        ]
    if args.rate_band is not None:
        low, high = _parse_rate_band(args.rate_band)
        out["sensitivity"] = {
            "low": _band_run(args, low, ppy, payment, lumps),
            "high": _band_run(args, high, ppy, payment, lumps),
        }
    if args.schedule:
        out["schedule"] = [
            {
                "period": r["period"],
                "rate_pct": _pct(r["rate"] * ppy * 100),
                "opening_balance": _money(r["opening_balance"], args.dp),
                "interest": _money(r["interest"], args.dp),
                "payment": _money(r["payment"], args.dp),
                "principal": _money(r["principal"], args.dp),
                "offset": _money(r["offset"], args.dp),
                "closing_balance": _money(r["closing_balance"], args.dp),
            }
            for r in schedule
        ]
    return out


def cmd_compound(args):
    if args.principal < 0:
        _die("--principal must be non-negative")
    if args.years <= 0:
        _die("--years must be positive")
    if args.n <= 0:
        _die("--n (compounding periods per year) must be positive")
    i = (args.rate / 100) / args.n
    periods = round(args.years * args.n)
    fv = _fv(args.principal, args.contribution, i, periods, args.timing)
    total_contributions = args.contribution * periods
    interest = fv - args.principal - total_contributions
    return {
        "command": "compound",
        "result": _money(fv, args.dp),
        "future_value": _money(fv, args.dp),
        "principal": _money(args.principal, args.dp),
        "annual_rate_pct": _pct(args.rate),
        "years": args.years,
        "periods_per_year": args.n,
        "num_periods": periods,
        "contribution_per_period": _money(args.contribution, args.dp),
        "timing": args.timing,
        "total_contributions": _money(total_contributions, args.dp),
        "interest_earned": _money(interest, args.dp),
    }


