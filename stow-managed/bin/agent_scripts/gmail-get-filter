#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///

import argparse, json, subprocess, sys

GWS = ["uvx", "gws-cli@1.3.1", "gmail", "get-filter"]


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def unwrap(obj):
    if isinstance(obj, str):
        try:
            return unwrap(json.loads(obj))
        except json.JSONDecodeError:
            return None
    if isinstance(obj, list):
        for item in obj:
            if isinstance(item, dict) and "id" in item:
                return item
        return None
    if isinstance(obj, dict):
        if "id" in obj:
            return obj
        for key in ("filter", "data"):
            if key in obj:
                found = unwrap(obj[key])
                if found is not None:
                    return found
    return None


def main():
    parser = argparse.ArgumentParser(description="Get one Gmail filter (gws-cli wrapper)")
    parser.add_argument("filter_id", help="Filter ID — see gmail-filters")
    parser.add_argument("--json", action="store_true", dest="json_out",
                        help="Output raw filter object as JSON")
    args = parser.parse_args()

    result = subprocess.run(GWS + [args.filter_id], capture_output=True, text=True)
    if result.returncode != 0:
        msg = result.stderr.strip()
        if result.stdout:
            try:
                err = json.loads(result.stdout)
                msg = err.get("message", msg) or msg
            except json.JSONDecodeError:
                pass
        eprint(msg)
        sys.exit(result.returncode)

    try:
        outer = json.loads(result.stdout)
    except json.JSONDecodeError:
        eprint("Unexpected non-JSON output:")
        print(result.stdout, end="")
        sys.exit(1)

    filt = unwrap(outer)
    if filt is None:
        eprint("Unrecognized get-filter response shape; raw output follows.")
        print(result.stdout, end="")
        sys.exit(1)

    if args.json_out:
        print(json.dumps(filt, indent=2))
        return

    print(f"Filter: {filt.get('id', '')}")
    criteria = filt.get("criteria", {})
    if criteria:
        print("Criteria:")
        for key, val in criteria.items():
            if val:
                print(f"  {key}: {val}")
    action = filt.get("action", {})
    if action:
        print("Action:")
        for key, val in action.items():
            if val:
                print(f"  {key}: {val}")


if __name__ == "__main__":
    main()
